{
  "name": "@dev-lib/server",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "start:dev": "NODE_ENV=development nest start --watch",
    "start:prod": "NODE_ENV=production node dist/main.js",
    "start:dev:all": "docker compose -f ../compose.yaml up --build mongo mongo-seed server",
    "start:dev:db": "docker compose -f ../compose.yaml up mongo mongo-seed",
    "seed:db": "node scripts/seed-db.mjs",
    "build": "nest build",
    "test": "jest --runInBand"
  },
  "dependencies": {
    "@nestjs/common": "^11.2.5",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.2.5",
    "@nestjs/mongoose": "^11.0.4",
    "@nestjs/platform-fastify": "^11.2.5",
    "@nestjs/throttler": "^6.7.1",
    "mongoose": "^9.10.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.24",
    "@nestjs/testing": "^11.2.7",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.3.1",
    "jest": "^30.1.3",
    "ts-jest": "^29.4.1",
    "ts-node": "^10.9.2",
    "typescript": "~5.9.3"
  }
}
